# ============================================
#  无扩展名文件（Linux 下 g++/gcc 编译出的可执行文件）
#  规则：忽略所有文件 → 放行目录 → 放行带扩展名的文件
#  必须放在最前面，后面的规则会覆盖这里
# ============================================
*
!*/
!*.*
!Makefile
!LICENSE

# ============================================
#  编译产物 / 可执行文件（自动生成，不该提交）
# ============================================

# C / C++
*.exe
*.out
*.o
*.obj
*.pdb
*.ilk
*.gch

# Java
*.class
out/

# Python
__pycache__/
*.pyc
*.pyo
*.pyz

# Python 虚拟环境
myenv/
venv/
.venv/
.learn_python_basic/
pyvenv.cfg

# PyInstaller 打包输出
build/
dist/
*.pkg
*.toc

# ============================================
#  文档（老师资料、实验报告等不进仓库）
# ============================================
*.doc
*.docx
*.pdf
*.ppt
*.pptx
*.xls
*.xlsx
# Office 打开文件时生成的临时锁文件
~$*

# ============================================
#  编辑器 / 系统
# ============================================
.idea/
*.iml
.DS_Store
Thumbs.db
# 从 Windows 复制下载文件到 WSL 时生成的来源标记
*:Zone.Identifier
